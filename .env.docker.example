GROQ_API=your_groq_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=sql-agent
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=your_google_api_key
SECRET_KEY=change_this_to_a_long_random_secret

# Optional external SQL database used by the SQL agent.
# On Docker Desktop, host.docker.internal points from the container to your Windows host.
CONNECTION_STRING=postgresql+psycopg2://postgres:1234@host.docker.internal:5432/pagila
